@model PagedList.IPagedList<BE4_LUUTHANHQUAN.Models.Product>
@using PagedList.Mvc
@{
    ViewBag.Title = ViewBag.CategoryName ?? "Sản phẩm";
    var categories = ViewBag.Categories as IEnumerable<BE4_LUUTHANHQUAN.Models.Category>;
}
<div class="container py-4">
    <h2 class="mb-3">@ViewBag.CategoryName</h2>
    @using (Html.BeginForm("ProductList", "Home", FormMethod.Get, new { @class = "row g-2 mb-4" }))
    {
        @Html.Hidden("categoryId", (object)ViewBag.CategoryId)
        <div class="col-md-5"><input class="form-control" name="searchTerm" value="@ViewBag.SearchTerm" placeholder="Tìm tên, mô tả sản phẩm..." /></div>
        <div class="col-md-4">
            <select class="form-select" name="sortOrder">
                <option value="">Tên A-Z</option>
                <option value="name_desc" @(ViewBag.SortOrder as string == "name_desc" ? "selected" : "")>Tên Z-A</option>
                <option value="price_asc" @(ViewBag.SortOrder as string == "price_asc" ? "selected" : "")>Giá tăng dần</option>
                <option value="price_desc" @(ViewBag.SortOrder as string == "price_desc" ? "selected" : "")>Giá giảm dần</option>
            </select>
        </div>
        <div class="col-md-3"><button class="btn btn-primary w-100" type="submit">Tìm kiếm / Sắp xếp</button></div>
    }
    <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <div class="card h-100 shadow-sm">
                    <a href="@Url.Action("ProductDetails", "Home", new { id = item.ProductID })">
                        <img src="@(String.IsNullOrWhiteSpace(item.ProductImage) ? Url.Content("~/Content/Images/images.jpg") : Url.Content(item.ProductImage))"
                             class="card-img-top p-3" style="height:190px;object-fit:contain" alt="@item.ProductName" />
                    </a>
                    <div class="card-body d-flex flex-column">
                        <h6 class="card-title">@item.ProductName</h6>
                        <div class="text-danger fw-bold mb-3">@item.ProductPrice.ToString("N0") đ</div>
                        <div class="mt-auto">
                            @Html.ActionLink("Xem chi tiết", "ProductDetails", "Home", new { id = item.ProductID }, new { @class = "btn btn-outline-primary btn-sm w-100" })
                        </div>
                    </div>
                </div>
            </div>
        }
        @if (!Model.Any()) { <div class="col-12"><div class="alert alert-info">Không tìm thấy sản phẩm phù hợp.</div></div> }
    </div>
    <div class="mt-4">
        @Html.PagedListPager(Model, p => Url.Action("ProductList", new { categoryId = ViewBag.CategoryId, searchTerm = ViewBag.SearchTerm, sortOrder = ViewBag.SortOrder, page = p }))
    </div>
</div>
