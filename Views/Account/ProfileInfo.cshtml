@model BE4_LUUTHANHQUAN.Models.ViewModel.ProfileVM
@{
    ViewBag.Title = "Thông tin tài khoản";
}
<div class="container py-4">
    <h2 class="mb-4">Thông tin tài khoản</h2>
    @if (TempData["Message"] != null) { <div class="alert alert-success">@TempData["Message"]</div> }
    @if (TempData["PasswordMessage"] != null) { <div class="alert alert-success">@TempData["PasswordMessage"]</div> }
    @if (TempData["PasswordError"] != null) { <div class="alert alert-danger">@TempData["PasswordError"]</div> }
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card shadow-sm"><div class="card-body">
                <h5 class="mb-3">Thông tin cá nhân</h5>
                @using (Html.BeginForm("UpdateProfile", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="mb-3">@Html.LabelFor(m => m.CustomerName, new { @class = "form-label" }) @Html.TextBoxFor(m => m.CustomerName, new { @class = "form-control" }) @Html.ValidationMessageFor(m => m.CustomerName, "", new { @class = "text-danger" })</div>
                    <div class="mb-3">@Html.LabelFor(m => m.CustomerPhone, new { @class = "form-label" }) @Html.TextBoxFor(m => m.CustomerPhone, new { @class = "form-control" }) @Html.ValidationMessageFor(m => m.CustomerPhone, "", new { @class = "text-danger" })</div>
                    <div class="mb-3">@Html.LabelFor(m => m.CustomerEmail, new { @class = "form-label" }) @Html.TextBoxFor(m => m.CustomerEmail, new { @class = "form-control", type = "email" }) @Html.ValidationMessageFor(m => m.CustomerEmail, "", new { @class = "text-danger" })</div>
                    <div class="mb-3">@Html.LabelFor(m => m.CustomerAddress, new { @class = "form-label" }) @Html.TextAreaFor(m => m.CustomerAddress, new { @class = "form-control", rows = 3 })</div>
                    <button class="btn btn-primary" type="submit">Lưu thông tin</button>
                }
            </div></div>
        </div>
        <div class="col-lg-5">
            <div class="card shadow-sm"><div class="card-body">
                <h5 class="mb-3">Đổi mật khẩu</h5>
                @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="mb-3"><label class="form-label">Mật khẩu hiện tại</label>@Html.PasswordFor(m => m.CurrentPassword, new { @class = "form-control" })</div>
                    <div class="mb-3"><label class="form-label">Mật khẩu mới</label>@Html.PasswordFor(m => m.NewPassword, new { @class = "form-control" })</div>
                    <div class="mb-3"><label class="form-label">Xác nhận mật khẩu mới</label>@Html.PasswordFor(m => m.ConfirmNewPassword, new { @class = "form-control" })</div>
                    <button class="btn btn-outline-primary" type="submit">Đổi mật khẩu</button>
                }
            </div></div>
            <div class="mt-3">@Html.ActionLink("Lịch sử mua hàng", "Index", "Orders", null, new { @class = "btn btn-outline-secondary w-100" })</div>
        </div>
    </div>
</div>
