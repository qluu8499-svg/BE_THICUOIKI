@model BE4_LUUTHANHQUAN.Models.ViewModel.AdminUserVM
@{
    ViewBag.Title = "Cập nhật tài khoản Admin";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<div class="container py-3" style="max-width:650px">
    <h2>ĐỔI MẬT KHẨU ADMIN</h2>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(m => m.Username)
        <div class="mb-3"><label class="form-label">Tên đăng nhập</label><input class="form-control" value="@Model.Username" disabled /></div>
        <div class="mb-3">@Html.LabelFor(m => m.Password, "Mật khẩu mới", new { @class = "form-label" }) @Html.PasswordFor(m => m.Password, new { @class = "form-control" }) @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })</div>
        <div class="mb-3">@Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label" }) @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" }) @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })</div>
        <button class="btn btn-primary">Lưu thay đổi</button>
        @Html.ActionLink("Quay lại", "Index", null, new { @class = "btn btn-outline-secondary ms-2" })
    }
</div>
