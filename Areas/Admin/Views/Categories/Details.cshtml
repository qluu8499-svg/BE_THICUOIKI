@model BE4_LUUTHANHQUAN.Models.Category

@{
    ViewBag.Title = "Chi tiết danh mục";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">THÔNG TIN CHI TIẾT CỦA DANH MỤC</h2>

<div class="form-horizontal">
    <hr />
    <div class="form-group row mb-3">
        <div class="control-label col-md-2">Tên danh mục</div>
        <div class="col-md-10">
            <div class="form-control" style="background-color:#eee;display:inline-block;width:auto;min-width:250px;">
                @Html.DisplayFor(model => model.CategoryName)
            </div>
        </div>
    </div>
    <div class="form-group mb-3">
        @Html.ActionLink("Cập Nhật", "Edit", new { id = Model.CategoryID }, new { @class = "btn btn-primary" })
        @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-outline-secondary" })
    </div>
</div>

<div class="mt-4">
    <h4>Sản phẩm thuộc danh mục (@(Model.Products == null ? 0 : Model.Products.Count))</h4>
    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="table-light"><tr><th>Mã sản phẩm</th><th>Tên sản phẩm</th><th>Đơn giá</th><th>Thao tác</th></tr></thead>
            <tbody>
            @if (Model.Products != null && Model.Products.Any())
            {
                foreach (var product in Model.Products)
                {
                    <tr>
                        <td>@product.ProductID</td>
                        <td>@product.ProductName</td>
                        <td>@product.ProductPrice.ToString("N0") đ</td>
                        <td>@Html.ActionLink("Xem sản phẩm", "Details", "Products", new { area = "Admin", id = product.ProductID }, new { @class = "btn btn-sm btn-outline-primary" })</td>
                    </tr>
                }
            }
            else
            {
                <tr><td colspan="4" class="text-center">Danh mục chưa có sản phẩm.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
