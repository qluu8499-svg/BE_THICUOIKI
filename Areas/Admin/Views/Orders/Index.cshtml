@model PagedList.IPagedList<BE4_LUUTHANHQUAN.Models.Order>
@using PagedList.Mvc
@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var statuses = new[] { "Chờ thanh toán", "Đang xử lý", "Đang vận chuyển", "Đã giao", "Đã hủy" };
}
<div class="container-fluid py-3">
    <h2>Quản lý đơn hàng</h2>
    <p class="text-muted">Tìm kiếm, theo dõi và xem chi tiết đơn hàng. Mỗi trang hiển thị 15 đơn hàng.</p>
    @if (TempData["OrderMessage"] != null) { <div class="alert alert-success">@TempData["OrderMessage"]</div> }
    @using (Html.BeginForm("Index", "Orders", new { area = "Admin" }, FormMethod.Get, new { @class = "card card-body mb-3" }))
    {
        <div class="row g-2 align-items-end">
            <div class="col-md-3"><label class="form-label">Tìm khách hàng / sản phẩm</label><input class="form-control" name="customerName" value="@ViewBag.CustomerName" placeholder="Tên, SĐT, email, tài khoản hoặc sản phẩm" /></div>
            <div class="col-md-3"><label class="form-label">Trạng thái thanh toán</label><select class="form-select" name="paymentStatus"><option value="">Tất cả trạng thái</option>@foreach (var s in statuses) { if ((ViewBag.PaymentStatus as string) == s) { <option value="@s" selected="selected">@s</option> } else { <option value="@s">@s</option> } }</select></div>
            <div class="col-md-2"><label class="form-label">Từ ngày</label><input type="date" class="form-control" name="fromDate" value="@ViewBag.FromDate" /></div>
            <div class="col-md-2"><label class="form-label">Đến ngày</label><input type="date" class="form-control" name="toDate" value="@ViewBag.ToDate" /></div>
            <div class="col-md-2"><label class="form-label">Sắp xếp</label>
                <select class="form-select" name="sortOrder">
                    @if (String.IsNullOrEmpty(ViewBag.SortOrder as string) || (ViewBag.SortOrder as string) == "date_desc") { <option value="date_desc" selected="selected">Ngày mới nhất</option> } else { <option value="date_desc">Ngày mới nhất</option> }
                    @if ((ViewBag.SortOrder as string) == "date_asc") { <option value="date_asc" selected="selected">Ngày cũ nhất</option> } else { <option value="date_asc">Ngày cũ nhất</option> }
                    @if ((ViewBag.SortOrder as string) == "amount_desc") { <option value="amount_desc" selected="selected">Giá trị cao nhất</option> } else { <option value="amount_desc">Giá trị cao nhất</option> }
                    @if ((ViewBag.SortOrder as string) == "amount_asc") { <option value="amount_asc" selected="selected">Giá trị thấp nhất</option> } else { <option value="amount_asc">Giá trị thấp nhất</option> }
                    @if ((ViewBag.SortOrder as string) == "customer_asc") { <option value="customer_asc" selected="selected">Tên khách hàng</option> } else { <option value="customer_asc">Tên khách hàng</option> }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2"><button class="btn btn-primary flex-grow-1">Tìm kiếm</button>@Html.ActionLink("Xóa lọc", "Index", null, new { @class = "btn btn-outline-secondary" })</div>
        </div>
    }
    <div class="d-flex justify-content-between align-items-center mb-2"><span>Tổng số kết quả: <strong>@Model.TotalItemCount</strong></span><span class="text-muted">Trang @Model.PageNumber / @Model.PageCount</span></div>
    <div class="table-responsive card">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Mã đơn</th><th>Khách hàng</th><th>Điện thoại</th><th>Ngày đặt</th><th>Số sản phẩm</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead>
            <tbody>
            @foreach (var o in Model)
            {
                <tr><td><b>#@o.OrderID</b></td><td>@(o.Customer == null ? "" : o.Customer.CustomerName)</td>
                    <td>@(o.Customer == null ? "" : o.Customer.CustomerPhone)</td><td>@o.OrderDate.ToString("dd/MM/yyyy")</td>
                    <td>@o.OrderDetails.Sum(d => d.Quantity)</td><td><b>@String.Format("{0:N0} đ", o.TotalAmount)</b></td>
                    <td><span class="badge bg-info text-dark">@o.PaymentStatus</span></td>
                    <td>@Html.ActionLink("Chi tiết đơn hàng", "Details", new { id = o.OrderID }, new { @class = "btn btn-sm btn-outline-primary" })</td></tr>
            }
            @if (!Model.Any()) { <tr><td colspan="8" class="text-center py-4">KHÔNG CÓ đơn hàng phù hợp.</td></tr> }
            </tbody>
        </table>
    </div>
    <div class="mt-3">@Html.PagedListPager(Model, p => Url.Action("Index", new { page = p, customerName = ViewBag.CustomerName, paymentStatus = ViewBag.PaymentStatus, fromDate = ViewBag.FromDate, toDate = ViewBag.ToDate, sortOrder = ViewBag.SortOrder }))</div>
</div>
