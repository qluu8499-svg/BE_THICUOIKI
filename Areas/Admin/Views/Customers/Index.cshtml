@model IEnumerable<BE4_LUUTHANHQUAN.Models.Customer>
@{
    ViewBag.Title = "Quản lý khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<h2>QUẢN LÝ KHÁCH HÀNG</h2>
@using (Html.BeginForm("Index", "Customers", FormMethod.Get, new { @class = "row g-2 mb-3" }))
{
    <div class="col-md-5">
        <input class="form-control" name="keyword" value="@ViewBag.Keyword" placeholder="Tên, số điện thoại, email hoặc tài khoản" />
    </div>
    <div class="col-auto"><button class="btn btn-primary" type="submit">Tìm kiếm</button></div>
    <div class="col-auto">@Html.ActionLink("Xóa lọc", "Index", null, new { @class = "btn btn-outline-secondary" })</div>
}
<div class="table-responsive">
<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark"><tr><th>Họ tên</th><th>Điện thoại</th><th>Email</th><th>Tài khoản</th><th>Số đơn</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.CustomerName</td><td>@item.CustomerPhone</td><td>@item.CustomerEmail</td>
            <td>@item.Username</td><td>@(item.Orders == null ? 0 : item.Orders.Count)</td>
            <td>@Html.ActionLink("Chi tiết", "Details", new { id = item.CustomerID }, new { @class = "btn btn-sm btn-outline-primary" })</td>
        </tr>
    }
    </tbody>
</table>
</div>
