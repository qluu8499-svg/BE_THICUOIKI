@model BE4_LUUTHANHQUAN.Models.Customer
@{
    ViewBag.Title = "Chi tiết khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
<h2>CHI TIẾT KHÁCH HÀNG</h2>
<div class="card mb-4"><div class="card-body">
    <dl class="row mb-0">
        <dt class="col-sm-3">Mã khách hàng</dt><dd class="col-sm-9">@Model.CustomerID</dd>
        <dt class="col-sm-3">Họ tên</dt><dd class="col-sm-9">@Model.CustomerName</dd>
        <dt class="col-sm-3">Điện thoại</dt><dd class="col-sm-9">@Model.CustomerPhone</dd>
        <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.CustomerEmail</dd>
        <dt class="col-sm-3">Địa chỉ</dt><dd class="col-sm-9">@Model.CustomerAddress</dd>
        <dt class="col-sm-3">Tài khoản</dt><dd class="col-sm-9">@Model.Username</dd>
    </dl>
</div></div>
<h4>LỊCH SỬ ĐƠN HÀNG</h4>
@Html.Partial("_CustomerOrders", Model.Orders.OrderByDescending(o => o.OrderDate))
<p class="mt-3">@Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-outline-secondary" })</p>
